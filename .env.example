# ============================================================
# NYC Taxi Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Data Warehouse PostgreSQL ────────────────────────────────
POSTGRES_WAREHOUSE_HOST=postgres-warehouse
POSTGRES_WAREHOUSE_PORT=5432
POSTGRES_WAREHOUSE_DB=mydb
POSTGRES_WAREHOUSE_USER=myuser
POSTGRES_WAREHOUSE_PASSWORD=changeme_in_prod

# ── Airflow Metadata PostgreSQL ──────────────────────────────
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=changeme_in_prod
POSTGRES_AIRFLOW_DB=airflow

# ── Airflow Core ─────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_ADMIN_PASSWORD=changeme_in_prod

# ── Redpanda / Kafka ─────────────────────────────────────────
REDPANDA_BOOTSTRAP=redpanda-1:29092
KAFKA_TOPIC_YELLOW=yellow_taxi_bookings
KAFKA_TOPIC_GREEN=green_taxi_bookings

# ── Spark Producer ───────────────────────────────────────────
# Path inside the spark-submit container
INPUT_DATA_PATH=/opt/spark/data/yellow_taxi/yellow_tripdata_2024-01.parquet

# ── RustFS / Object Storage (optional) ──────────────────────
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=changeme_in_prod
